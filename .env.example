# ══════════════════════════════════════════════════════════
#  Do not put values in this file. It only lists key names.
#  Copy it to .env and fill in the values there. .env is never committed.
#
#  Most values should preferably be entered into the DB via the system
#  admin (/_admin). The environment variables here are fallbacks used
#  when the DB has no value.
#  Exception: social login ON/OFF is controlled from the DB only.
# ══════════════════════════════════════════════════════════

# ── Required: app ──────────────────────────
# None of these are platform-injected — set every one in .env before running
# migrations (`mix ecto.migrate`) or the server.
DATABASE_URL=                   # format: ecto://USER:PASS@localhost/DATABASE
SECRET_KEY_BASE=                # generate: mix phx.gen.secret
CLOAK_KEY=                      # openssl rand -base64 32  (boot fails without it)
PHX_HOST=                       # public hostname (prod only)
# PORT is optional; a value injected by the deploy platform wins.
# Defaults and the empty-vs-malformed rule: docs/07-config-admin.md > Boot parameter defaults.
PORT=
APP_BASE_URL=

# ── Boot / release (usually leave empty locally) ─────────
# Everything below is read by backend/config/runtime.exs at boot. In local
# dev the defaults are correct; these matter mostly for prod releases.
#
# Platform-injected — do not set locally:
#   PORT        injected by the deploy platform (see above)
#   PHX_SERVER  set by the Dockerfile (ENV PHX_SERVER="true"); tells a release
#               to start the HTTP server. `mix phx.server` does not need it.
PHX_SERVER=
# true | 1 = connect to the database over IPv6 (prod releases only)
ECTO_IPV6=
# DB connection pool size (prod releases only)
POOL_SIZE=
# DNS name for node clustering (prod releases only)
DNS_CLUSTER_QUERY=
# Dev-only HTTPS listener: DEV_BIND_ALL=true additionally serves HTTPS on HTTPS_PORT.
# Defaults: docs/07-config-admin.md > Boot parameter defaults.
DEV_BIND_ALL=
HTTPS_PORT=
#
# REDIS_URL is intentionally absent: this app does not use Redis.

# ── Storage (AWS S3) ───────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_BASE_URL=
# Signed playback URL expiry (seconds). If empty, the server picks a value
# based on recording length (min 900, max 21600)
STORAGE_DOWNLOAD_URL_TTL_SECONDS=

# ── Transcription (Google Cloud STT v2) ────
STT_CREDENTIALS_JSON=           # service account JSON string
STT_PROJECT_ID=
STT_LOCATION=
STT_RECOGNIZER=
STT_GCS_BUCKET=                 # temporary bucket for batchRecognize
STT_DEV_MODE=                   # true = mock responses, no real calls

# ── AI summary (LLM) ───────────────────────
# Values entered into the DB via the admin (/_admin/llm) take precedence.
# These are fallbacks when the DB has no row.
LLM_PROVIDER=                   # gemini | anthropic | openai
LLM_API_KEY=
LLM_MODEL=
LLM_DEV_MODE=                   # true = produce a mock summary without calling the LLM
LLM_AUTO_SUMMARIZE=             # true = summarize automatically when transcription finishes

# ── Social login (optional) ────────────────
#  Only the keys live here; actual ON/OFF is toggled in the admin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ── Mail ───────────────────────────────────
MAIL_PROVIDER=
MAIL_DOMAIN=
MAIL_API_KEY=

# ── Web push ───────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# true only when behind a reverse proxy. When on, X-Forwarded-For is used as
# the visitor IP. Enabling it without a proxy lets a single header bypass
# IP-based rate limits.
APP_TRUST_PROXY_HEADERS=
# Timezone for dates in meeting-notes exports. If empty, Asia/Seoul
APP_TIMEZONE=

# ── Initial admin (first run only) ─────────────────
# `mix run priv/repo/seeds.exs` creates the first admin with these values.
# If the password is empty, a random one is generated and printed to the screen once.
# **No defaults are provided** — if every deployment shared the same account,
# that alone would be an attack target.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Khala integration ──────────────────────────────
# Sends meeting summaries to the Khala inbox (docs/15-mcp-khala.md).
#
# **There is no secret.** Khala is a public client (PKCE), so no client_secret
# is used, and the client_id is obtained via dynamic client registration.
# All that goes here is the address and on/off.
KHALA_ENABLED=
# e.g. https://mcp.khala.to/mcp
# OAuth endpoints are discovered automatically from this address's /.well-known.
KHALA_MCP_URL=
