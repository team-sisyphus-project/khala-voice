# ══════════════════════════════════════════════════════════
#  값을 여기에 적지 마세요. 이 파일은 키 이름만 나열합니다.
#  복사해서 .env 를 만들고 거기에 채우세요. .env 는 커밋되지 않습니다.
#
#  대부분의 값은 시스템 어드민(/_admin)에서 DB로 입력하는 것이 우선입니다.
#  여기 환경변수는 DB에 값이 없을 때의 폴백입니다.
#  단, 소셜 로그인의 ON/OFF 는 DB에서만 제어됩니다.
# ══════════════════════════════════════════════════════════

# ── 필수: 앱 ───────────────────────────────
DATABASE_URL=
SECRET_KEY_BASE=
CLOAK_KEY=                      # openssl rand -base64 32  (없으면 부팅 실패)
PHX_HOST=
PORT=
APP_BASE_URL=

# ── 스토리지 (AWS S3) ──────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_BASE_URL=
# 재생용 서명 URL 만료(초). 비우면 녹음 길이에 맞춰 서버가 정한다(최소 900, 최대 21600)
STORAGE_DOWNLOAD_URL_TTL_SECONDS=

# ── 전사 (Google Cloud STT v2) ─────────────
STT_CREDENTIALS_JSON=           # 서비스 계정 JSON 문자열
STT_PROJECT_ID=
STT_LOCATION=
STT_RECOGNIZER=
STT_GCS_BUCKET=                 # batchRecognize 임시 버킷
STT_DEV_MODE=                   # true 면 실제 호출 없이 목 응답

# ── AI 요약 (LLM) ──────────────────────────
# 어드민(/_admin/llm)에서 DB에 넣는 것이 우선이다. 여기 값은 DB에 행이 없을 때의 폴백.
LLM_PROVIDER=                   # gemini | anthropic | openai
LLM_API_KEY=
LLM_MODEL=
LLM_DEV_MODE=                   # true 면 LLM을 호출하지 않고 목 요약을 만든다
LLM_AUTO_SUMMARIZE=             # true 면 전사가 끝날 때 자동으로 요약한다

# ── 소셜 로그인 (선택) ─────────────────────
#  키만 여기 두고, 실제 ON/OFF 는 어드민에서 합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ── 메일 ───────────────────────────────────
MAIL_PROVIDER=
MAIL_DOMAIN=
MAIL_API_KEY=

# ── 웹 푸시 ────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 리버스 프록시 뒤에 있을 때만 true. 켜면 X-Forwarded-For 를 방문자 IP 로 쓴다.
# 프록시가 없는데 켜면 헤더 한 줄로 IP 기반 제한을 우회당한다.
APP_TRUST_PROXY_HEADERS=
# 회의록 내보내기의 날짜 표기 기준. 비우면 Asia/Seoul
APP_TIMEZONE=

# ── 초기 어드민 (최초 1회) ──────────────────────────
# `mix run priv/repo/seeds.exs` 가 이 값으로 첫 어드민을 만든다.
# 비밀번호를 비우면 무작위로 만들어 화면에 한 번 출력한다.
# **기본값을 두지 않는다** — 모든 배포본이 같은 계정을 쓰면 그 자체가 공격 대상이다.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
