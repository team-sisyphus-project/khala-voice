# ══════════════════════════════════════════════════════════
#  Do not put values in this file. It only lists key names.
#  Copy it to .env and fill in the values there. .env is never committed.
#
#  Most values should preferably be entered into the DB via the system
#  admin (/_admin). The environment variables here are fallbacks used
#  when the DB has no value.
#  Exception: social login ON/OFF is controlled from the DB only.
# ══════════════════════════════════════════════════════════

# ── Required: three conditions, not one ────
# None of these are platform-injected — you set them yourself. Which ones a
# given step needs splits three ways; docs/07-config-admin.md ("Entry points")
# has the matrix.
#   app boot             DATABASE_URL, SECRET_KEY_BASE, CLOAK_KEY. Locally this
#                        covers `mix ecto.migrate` too — a mix task boots the app.
#   migration only       DATABASE_URL. `bin/vr eval 'VR.Release.migrate()'` reads
#                        no app secret; the seed beside it adds CLOAK_KEY only.
#   preview preparation  PHX_HOST, PHX_SCHEME, APP_BASE_URL. Non-secret, and no
#                        command halts on them: they decide whether a running
#                        preview is usable, not whether it starts. Production
#                        wants the same three, with PHX_SCHEME left empty.
DATABASE_URL=                   # format: ecto://USER:PASS@localhost/DATABASE
SECRET_KEY_BASE=                # generate: mix phx.gen.secret
CLOAK_KEY=                      # openssl rand -base64 32  (boot fails without it)
PHX_HOST=                       # public host (preview/prod; if empty, localhost)
# PHX_HOST / PHX_SCHEME / PHX_URL_PORT together describe how the outside world
# reaches this app — the scheme, host and port stamped onto every absolute URL
# it generates (Khala OAuth callback, MCP metadata). What it listens on is PORT,
# in the boot section below; what share links and account emails carry is
# APP_BASE_URL, right below here.
#   PHX_SCHEME    http | https. If empty, https.
#   PHX_URL_PORT  public port. If empty, the port that scheme omits from a URL.
# Leave both empty for the usual setup: a TLS terminator in front, https://host.
# Set PHX_SCHEME=http for a preview served over plain HTTP, and add
# PHX_URL_PORT only when the public port is also non-standard (http://host:4000).
# The numbers behind "if empty", and what a malformed value does:
# docs/07-config-admin.md > Boot parameter defaults.
PHX_SCHEME=
PHX_URL_PORT=
# APP_BASE_URL is the other URL source, and PHX_HOST does not feed it: share
# links (/share/<token>) and account emails (confirm, reset, friend invite) are
# built from this value alone. Leave it empty and a share link comes out as a
# bare path and account mail is never sent. Same scheme, host and public port as
# the three above — e.g. http://preview.example.test for a plain-HTTP preview.
APP_BASE_URL=

# ── Boot / release (usually leave empty locally) ─────────
# Everything below is read by backend/config/runtime.exs at boot. In local
# dev the defaults are correct; these matter mostly for prod releases.
#
# Platform-injected — do not set locally:
#   PORT            injected by the deploy platform, and an injected value wins.
#                   Never required: empty takes the default, malformed halts boot.
#                   Defaults and the empty-vs-malformed rule:
#                   docs/07-config-admin.md > Boot parameter defaults.
#   PHX_SERVER      set by the Dockerfile (ENV PHX_SERVER="true"); tells a release
#                   to start the HTTP server. `mix phx.server` does not need it.
#   RELEASE_COMMAND exported by the release launcher as the command it was given
#                   (start | daemon | eval | rpc | remote). runtime.exs reads it
#                   to tell the app-boot entry point from the migration entry
#                   point `bin/vr eval 'VR.Release.migrate()'`, which needs
#                   DATABASE_URL but neither SECRET_KEY_BASE nor CLOAK_KEY.
#                   Setting it by hand only lies about which command is running.
PORT=
PHX_SERVER=
RELEASE_COMMAND=
# true | 1 = connect to the database over IPv6 (prod releases only)
ECTO_IPV6=
# DB connection pool size (prod releases only)
POOL_SIZE=
# DNS name for node clustering (prod releases only)
DNS_CLUSTER_QUERY=
# Dev-only HTTPS listener: DEV_BIND_ALL=true additionally serves HTTPS on
# HTTPS_PORT. A malformed HTTPS_PORT halts the app, same as PORT.
# Defaults: docs/07-config-admin.md > Boot parameter defaults.
DEV_BIND_ALL=
HTTPS_PORT=
#
# REDIS_URL is intentionally absent: this app does not use Redis.

# ── Storage (AWS S3) ───────────────────────
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_CDN_BASE_URL=
# Signed playback URL expiry (seconds). If empty, the server picks a value
# based on recording length (min 900, max 21600)
STORAGE_DOWNLOAD_URL_TTL_SECONDS=

# ── Transcription (Google Cloud STT v2) ────
STT_CREDENTIALS_JSON=           # service account JSON string
STT_PROJECT_ID=
STT_LOCATION=
STT_RECOGNIZER=
STT_GCS_BUCKET=                 # temporary bucket for batchRecognize
STT_DEV_MODE=                   # true = mock responses, no real calls

# ── AI summary (LLM) ───────────────────────
# Values entered into the DB via the admin (/_admin/llm) take precedence.
# These are fallbacks when the DB has no row.
LLM_PROVIDER=                   # gemini | anthropic | openai
LLM_API_KEY=
LLM_MODEL=
LLM_DEV_MODE=                   # true = produce a mock summary without calling the LLM
LLM_AUTO_SUMMARIZE=             # true = summarize automatically when transcription finishes

# ── Social login (optional) ────────────────
#  Only the keys live here; actual ON/OFF is toggled in the admin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ── Mail ───────────────────────────────────
MAIL_PROVIDER=
MAIL_DOMAIN=
MAIL_API_KEY=

# ── Web push ───────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# true only when behind a reverse proxy. When on, X-Forwarded-For is used as
# the visitor IP. Enabling it without a proxy lets a single header bypass
# IP-based rate limits.
APP_TRUST_PROXY_HEADERS=
# Timezone for dates in meeting-notes exports. If empty, Asia/Seoul
APP_TIMEZONE=

# ── Initial admin (first run only) ─────────────────
# The seed step creates the first admin with these values — `mix run
# priv/repo/seeds.exs` locally, `bin/vr eval 'VR.Release.seed()'` in a release
# (the deploy runs it right after the migration). `mix vr.bootstrap_admin` reads
# the same two and creates the same account, and nothing else.
# If the password is empty, a random one is generated and printed to the screen
# once. A password set here is never printed — you already have it.
# Without the email the seed skips the admin and nothing else: the app runs, but
# no one can open /_admin until you set one and run the seed again.
# `mix vr.bootstrap_admin` stops there instead — creating that account is all it
# does, so an address it does not have is a command that did nothing.
# **No defaults are provided** — if every deployment shared the same account,
# that alone would be an attack target.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Khala integration ──────────────────────────────
# Sends meeting summaries to the Khala inbox (docs/15-mcp-khala.md).
#
# **There is no secret.** Khala is a public client (PKCE), so no client_secret
# is used, and the client_id is obtained via dynamic client registration.
# All that goes here is the address and on/off.
KHALA_ENABLED=
# e.g. https://mcp.khala.to/mcp
# OAuth endpoints are discovered automatically from this address's /.well-known.
KHALA_MCP_URL=
