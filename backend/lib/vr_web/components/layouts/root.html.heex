<!DOCTYPE html>
<html lang={locale(assigns)} data-theme={theme(assigns)}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png" />
    <%!-- iOS ignores the manifest's display setting. This meta tag is required for fullscreen mode --%>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="KHALA VOICE" />

    <.live_title default="KHALA VOICE" suffix=" · KHALA VOICE">
      {assigns[:page_title]}
    </.live_title>

    <%!-- Material Symbols Rounded — the same icon set as sisyphus --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..500,0..1,0"
    />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>

    <script>
      // Apply theme and accessibility settings before first paint (prevents flicker).
      //
      // The server has already stamped the account's theme onto html[data-theme].
      // Before sign-in, or when the server value is absent, use the localStorage cache.
      //
      // All four themes ship in the bundle (`packages/ui-styles`) — nothing is fetched separately.
      (() => {
        const root = document.documentElement;

        for (const key of ["reduce-motion", "reduce-blur"]) {
          if (localStorage.getItem("vr:" + key) === "true") {
            root.setAttribute("data-" + key, "true");
          }
        }

        const server = root.getAttribute("data-theme");
        const cached = localStorage.getItem("vr:theme");
        const theme = server || cached || "light";

        root.setAttribute("data-theme", theme);
        if (server) localStorage.setItem("vr:theme", server);
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
